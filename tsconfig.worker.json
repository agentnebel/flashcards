{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "composite": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "worker",
    "src/lib/mediaGcPolicy.ts",
    "src/lib/syncProtocol.ts"
  ],
  "exclude": ["worker/**/*.test.ts"]
}
